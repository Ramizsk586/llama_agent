# ---- Convex ----
# Get these by running: npx convex dev
# Convex will create a project and auto-populate your .env.local.
CONVEX_DEPLOYMENT=
CONVEX_URL=
VITE_CONVEX_URL=

# ---- Llama Bridge connection ----
# All agent LLM requests go through the local Llama Bridge.
LLAMA_BRIDGE_URL=http://127.0.0.1:8089
LLAMA_BRIDGE_MODEL=default
# Optional if your bridge requires a bearer token.
# LLAMA_BRIDGE_API_KEY=

# ---- Telegram ----
# Create a bot with BotFather, then paste the token here.
TELEGRAM_BOT_TOKEN=
# Optional chat ID for proactive notices, such as Gmail alerts.
TELEGRAM_NOTIFY_CHAT_ID=

# ---- Proactive email surfacing ----
# Set to "false" to skip auto-registering the Composio webhook URL on each
# `npm run dev`. Use when you want to manage the subscription manually.
# COMPOSIO_AUTO_WEBHOOK=

# ---- Upgrade notifications ----
# On `npm run dev`, Boop checks your `upstream` remote for new commits.
# Set to `false` to silence the check entirely.
# BOOP_UPSTREAM_CHECK=true

# ---- Embeddings (optional - paid providers for memory recall) ----
# Tried in order: Voyage -> OpenAI -> local Transformers.js.
# VOYAGE_API_KEY=
# OPENAI_API_KEY=

# ---- Server ----
PORT=3456

# Public URL for Composio webhooks if using proactive integrations.
PUBLIC_URL=http://localhost:3456

# Optional: ngrok RESERVED domain (paid plan). Example: "boop.ngrok.app".
# When set, `npm run dev` launches ngrok with --domain=$NGROK_DOMAIN.
# NGROK_DOMAIN=

# ---- Composio (1000+ integrations, zero-code) ----
# Get an API key at https://app.composio.dev/developers.
COMPOSIO_API_KEY=

# Optional: stable user id Composio keys connections under.
# COMPOSIO_USER_ID=
