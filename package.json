{
  "name": "boop-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram personal agent backed by Llama Bridge.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "preflight": "node scripts/preflight.mjs",
    "check:upstream": "node scripts/check-upstream.mjs --tips",
    "dev": "node scripts/dev.mjs",
    "dev:parallel": "npm-run-all --parallel dev:server dev:convex dev:debug",
    "dev:server": "npm run preflight && tsx watch server/index.ts",
    "dev:convex": "convex dev",
    "dev:debug": "vite --config debug/vite.config.ts",
    "build:debug": "vite build --config debug/vite.config.ts",
    "start": "npm run preflight && tsx server/index.ts",
    "deploy:convex": "convex deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.141",
    "@composio/claude-agent-sdk": "^0.9.2",
    "@composio/core": "^0.10.0",
    "@hugeicons/core-free-icons": "^4.1.4",
    "@hugeicons/react": "^1.0.0",
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "convex": "^1.38.0",
    "cors": "^2.8.5",
    "croner": "^10.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.0.0",
    "node-telegram-bot-api": "^0.67.0",
    "react-force-graph-2d": "^1.27.0",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^25.7.0",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^6.0.1",
    "npm-run-all": "^4.1.5",
    "prompts": "^2.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.12"
  },
  "engines": {
    "node": ">=20"
  }
}
